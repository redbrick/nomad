dn: olcDatabase={2}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to dn.subtree="ou=accounts,o=redbrick,dc=redbrick,dc=dcu,dc=ie" attrs=userPassword
  by self write
  by anonymous auth
  by * none
olcAccess: {1}to attrs=userPassword
  by anonymous auth
  by * none
olcAccess: {2}to *
  by dn.subtree="ou=serviceAccounts,o=redbrick,dc=redbrick,dc=dcu,dc=ie" read
  by * none
